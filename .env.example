# Copy this file to .env and fill in real values. .env itself is gitignored
# and should never be committed.

# Get a free key at https://dashboard.voyageai.com/ — used for embeddings.
VOYAGE_API_KEY=your-voyage-api-key-here

# Get a free key at https://console.groq.com/ — used for grounded generation
# and the ethics scorecard (runs Llama 3.3 on Groq's free tier).
GROQ_API_KEY=your-groq-api-key-here
